# Odin Personal AI Assistant - Environment Configuration

# Workspace - Odin has full autonomy inside this directory
ODIN_WORKSPACE=/home/caua/odin-workspace

# Server
ODIN_HOST=127.0.0.1
ODIN_PORT=8000
# To reach the backend from the phone (mobile app / Expo) on the same network,
# set ODIN_HOST=0.0.0.0, restart (`odin restart`) and connect the app to
# http://<your-lan-ip>:8000 (find it with `hostname -I`). `odin`/`scripts/server.sh`
# read ODIN_HOST/ODIN_PORT from this .env file.
#
# CORS - browser origins allowed to call the API. Defaults cover the Vite dev
# server (3000) and the Expo web dev server (8081), plus any private LAN origin.
# Native mobile clients (Expo Go) do not enforce CORS, so this only matters for
# the web builds.
# ODIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Security - optional bearer token required for /api/* (empty = disabled).
# When set, every /api/* request must send `Authorization: Bearer <token>`
# (WebSocket clients may pass `?token=<token>` instead). The mobile app stores
# its token in the app's "Configurações" screen; the web panel stores a signed
# session token obtained from the login screen (see below).
#
# IMPORTANT: the backend REFUSES to start on a non-loopback ODIN_HOST when this
# is empty — exposing Odin without a token is remote code execution. For
# hosting, bind to 127.0.0.1 and use a Cloudflare tunnel (see README.deploy.md).
# ODIN_API_TOKEN=change-me-long-random-string
# Failed-token attempts per client within the window before the API answers 429.
# ODIN_AUTH_MAX_FAILURES=10
# ODIN_AUTH_WINDOW_SECONDS=60
#
# Web panel login sessions. The panel exchanges ODIN_API_TOKEN for a signed,
# expiring session token at POST /api/auth/login, so the raw token never has to
# be pasted into localStorage. Empty ODIN_SESSION_SECRET derives the signing
# secret from ODIN_API_TOKEN (rotating the token then invalidates all sessions).
# ODIN_SESSION_SECRET=
# ODIN_SESSION_TTL_DAYS=7      # "remember me" checked (default)
# ODIN_SESSION_TTL_HOURS=12    # "remember me" unchecked

# LLM Provider: gemini | groq | ollama | openai | anthropic
# Every provider is served by one LiteLLM-backed adapter
# (backend/app/agent/providers/litellm_provider.py), so adding a provider means
# adding a ProviderMeta to backend/app/agent/providers/catalog.py.
# ODIN_MODEL is the vendor model id; the vendor prefix is added automatically
# (e.g. ODIN_MODEL=gemini-2.5-flash -> "gemini/gemini-2.5-flash").
ODIN_MODEL_PROVIDER=gemini
ODIN_MODEL=gemini-2.5-flash

# --- Gemini (ODIN_MODEL_PROVIDER=gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq (ODIN_MODEL_PROVIDER=groq) ---
# GROQ_API_KEY=your_groq_api_key_here
# ODIN_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (ODIN_MODEL_PROVIDER=ollama) ---
# ODIN_MODEL_PROVIDER=ollama
# ODIN_MODEL=qwen3:0.6b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_THINK=false  # default; true turns on reasoning (qwen3 + thinking breaks tool calling)

# --- OpenAI (ODIN_MODEL_PROVIDER=openai) ---
# ODIN_MODEL_PROVIDER=openai
# ODIN_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here

# --- Anthropic (ODIN_MODEL_PROVIDER=anthropic) ---
# ODIN_MODEL_PROVIDER=anthropic
# ODIN_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Resilience ---
# Transient provider failures (a 429 rate limit on a free tier, a 5xx, or a
# timeout) are retried with exponential backoff before the turn is abandoned.
# Retries only happen while nothing has been streamed yet, so they can never
# duplicate output; a "Provider rate limited — retrying…" status is shown in
# the chat meanwhile. ODIN_LLM_MAX_RETRIES counts retries after the first
# attempt (3 => up to 4 requests).
# ODIN_LLM_MAX_RETRIES=3
# ODIN_LLM_RETRY_BASE_DELAY=1.0
# ODIN_LLM_RETRY_MAX_DELAY=30.0

# --- Long-term memory (Phase 3, optional) ---
# Off by default: when disabled (or when Mem0 is not installed) the agent
# behaves exactly as before and Mem0 is never imported. To enable, install the
# optional deps (backend/requirements-memory.txt) and set the vars below.
#
# Local-first: Mem0's extraction LLM and its embedder both use your local
# Ollama (OLLAMA_BASE_URL) and the vector store is embedded on disk — no server,
# no API keys, zero marginal cost. Pull the models first, e.g.:
#   ollama pull qwen3:0.6b && ollama pull nomic-embed-text
# ODIN_MEMORY_ENABLED=true
# ODIN_MEMORY_LLM_MODEL=qwen3:0.6b              # Mem0 extraction LLM
# ODIN_MEMORY_LLM_PROVIDER=ollama                # or groq/openai/anthropic/gemini
# ODIN_MEMORY_LLM_MAX_TOKENS=1024                # cap on extraction output
# ODIN_MEMORY_NUM_CTX=16384                      # Ollama context; must fit the
#                                                # ~7.4k-token extraction prompt
# ODIN_MEMORY_EMBEDDER_MODEL=nomic-embed-text   # Mem0 embedder (Ollama)
# ODIN_MEMORY_VECTOR_STORE=chroma               # embedded store (no server)
# ODIN_MEMORY_PATH=                             # empty = Mem0 default location
# ODIN_MEMORY_USER_ID=odin                       # namespace for the memories
# ODIN_MEMORY_RECALL_LIMIT=5                     # memories recalled per turn
#
# Extraction is heavy (~7.4k-token prompt). On CPU-only machines set INFER=false:
# Mem0 then stores the raw turns and recalls them by embedding similarity — no
# extraction LLM at all (fast and fully offline).
# ODIN_MEMORY_INFER=false

# --- MCP servers (Model Context Protocol) ---
# Plug external MCP servers in and their tools become agent tools. Optional and
# disabled by default (empty). The SDK (`mcp`, see backend/requirements.txt) is
# imported lazily; with no servers configured the backend behaves exactly as
# before.
#
# Value: a JSON array of server objects.
#   name       (required) short id; also namespaces the tools (mcp__<name>__<tool>)
#   transport  "stdio" (default) | "sse" | "http"
#   stdio:  command (required), args (list), env (map), cwd
#   sse/http: url (required), headers (map)
#   trusted    (default false) — see the security note below
#
# SECURITY: MCP tools run in an external process that Odin's PathGuard cannot
# see, so EVERY MCP tool requires explicit user approval by default (same
# Approve/Deny flow as execute_command). Only servers you mark "trusted": true
# skip that blanket approval; even then, any path-like argument is still checked
# against the workspace boundary.
#
# Example — a local filesystem server (untrusted → asks for approval):
# ODIN_MCP_SERVERS=[{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
#
# Example — a remote SSE server you trust:
# ODIN_MCP_SERVERS=[{"name":"remote","transport":"sse","url":"http://localhost:3001/sse","trusted":true}]
#
# Seconds to wait for each server to connect during startup (never blocks boot
# beyond this, per server).
# ODIN_MCP_STARTUP_TIMEOUT=8

# --- Daily briefing ---
# City + coordinates used for the Open-Meteo weather lookup.
# ODIN_WEATHER_CITY=São José dos Campos
# ODIN_WEATHER_LAT=-23.1794
# ODIN_WEATHER_LON=-45.8869
# Comma-separated git repositories shown in the briefing (entries that are not
# git repos are reported as null).
# ODIN_BRIEFING_REPOS=/home/caua/odin,/home/caua/odin-workspace

# Database
DATABASE_URL=sqlite+aiosqlite:///./odin.db

# Debug
DEBUG=false
