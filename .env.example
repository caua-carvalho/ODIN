# Odin Personal AI Assistant - Environment Configuration

# Workspace - Odin has full autonomy inside this directory
ODIN_WORKSPACE=/home/caua/odin-workspace

# Server
ODIN_HOST=127.0.0.1
ODIN_PORT=8000

# LLM Provider: gemini | ollama
# To add a new provider, create an adapter in backend/app/agent/providers/
# and register it in backend/app/agent/providers/factory.py
ODIN_MODEL_PROVIDER=gemini
ODIN_MODEL=gemini-2.5-flash

# --- Gemini (ODIN_MODEL_PROVIDER=gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Ollama (ODIN_MODEL_PROVIDER=ollama) ---
# ODIN_MODEL_PROVIDER=ollama
# ODIN_MODEL=qwen3:0.6b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_THINK=false  # default; true turns on reasoning (qwen3 + thinking breaks tool calling)

# Database
DATABASE_URL=sqlite+aiosqlite:///./odin.db

# Debug
DEBUG=false
