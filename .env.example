# Odin Personal AI Assistant - Environment Configuration

# Workspace - Odin has full autonomy inside this directory
ODIN_WORKSPACE=/home/caua/odin-workspace

# Server
ODIN_HOST=127.0.0.1
ODIN_PORT=8000
# To reach the backend from the phone (mobile app / Expo) on the same network,
# set ODIN_HOST=0.0.0.0, restart (`odin restart`) and connect the app to
# http://<your-lan-ip>:8000 (find it with `hostname -I`). `odin`/`scripts/server.sh`
# read ODIN_HOST/ODIN_PORT from this .env file.
#
# CORS - browser origins allowed to call the API. Defaults cover the Vite dev
# server (3000) and the Expo web dev server (8081), plus any private LAN origin.
# Native mobile clients (Expo Go) do not enforce CORS, so this only matters for
# the web builds.
# ODIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Security - optional bearer token required for /api/* (empty = disabled).
# When set, every /api/* request must send `Authorization: Bearer <token>`
# (WebSocket clients may pass `?token=<token>` instead). The mobile app stores
# its token in the app's "Configurações" screen; the web panel stores a signed
# session token obtained from the login screen (see below).
#
# IMPORTANT: the backend REFUSES to start on a non-loopback ODIN_HOST when this
# is empty — exposing Odin without a token is remote code execution. For
# hosting, bind to 127.0.0.1 and use a Cloudflare tunnel (see README.deploy.md).
# ODIN_API_TOKEN=change-me-long-random-string
# Failed-token attempts per client within the window before the API answers 429.
# ODIN_AUTH_MAX_FAILURES=10
# ODIN_AUTH_WINDOW_SECONDS=60
#
# Web panel login sessions. The panel exchanges ODIN_API_TOKEN for a signed,
# expiring session token at POST /api/auth/login, so the raw token never has to
# be pasted into localStorage. Empty ODIN_SESSION_SECRET derives the signing
# secret from ODIN_API_TOKEN (rotating the token then invalidates all sessions).
# ODIN_SESSION_SECRET=
# ODIN_SESSION_TTL_DAYS=7      # "remember me" checked (default)
# ODIN_SESSION_TTL_HOURS=12    # "remember me" unchecked

# LLM Provider: gemini | groq | ollama
# To add a new provider, create an adapter in backend/app/agent/providers/
# and register it in backend/app/agent/providers/factory.py
ODIN_MODEL_PROVIDER=gemini
ODIN_MODEL=gemini-2.5-flash

# --- Gemini (ODIN_MODEL_PROVIDER=gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq (ODIN_MODEL_PROVIDER=groq) ---
# GROQ_API_KEY=your_groq_api_key_here
# ODIN_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (ODIN_MODEL_PROVIDER=ollama) ---
# ODIN_MODEL_PROVIDER=ollama
# ODIN_MODEL=qwen3:0.6b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_THINK=false  # default; true turns on reasoning (qwen3 + thinking breaks tool calling)

# --- Daily briefing ---
# City + coordinates used for the Open-Meteo weather lookup.
# ODIN_WEATHER_CITY=São José dos Campos
# ODIN_WEATHER_LAT=-23.1794
# ODIN_WEATHER_LON=-45.8869
# Comma-separated git repositories shown in the briefing (entries that are not
# git repos are reported as null).
# ODIN_BRIEFING_REPOS=/home/caua/odin,/home/caua/odin-workspace

# Database
DATABASE_URL=sqlite+aiosqlite:///./odin.db

# Debug
DEBUG=false
