# Odin - Production / hosting environment.
#
# Copy to .env on the host and fill in the values:
#   cp .env.production.example .env
#
# Read README.deploy.md for the full walkthrough. The golden rule: Odin binds
# to 127.0.0.1 and is exposed ONLY through a Cloudflare tunnel, so no inbound
# port is ever opened.

# --- Bind address -----------------------------------------------------------
# Keep loopback. The Cloudflare tunnel connects to it from the same machine.
# The backend REFUSES to start on a non-loopback host without ODIN_API_TOKEN.
ODIN_HOST=127.0.0.1
ODIN_PORT=8000

# --- Workspace --------------------------------------------------------------
# Directory where the agent has full autonomy. Use a dedicated path owned by
# the service user.
ODIN_WORKSPACE=/var/lib/odin/workspace

# --- Security ---------------------------------------------------------------
# REQUIRED for hosting. Generate with:  openssl rand -hex 32
ODIN_API_TOKEN=change-me-to-a-long-random-string
# Failed-token attempts per client before the API returns 429.
ODIN_AUTH_MAX_FAILURES=10
ODIN_AUTH_WINDOW_SECONDS=60

# Public origin of the panel, so browser CORS matches the tunnel hostname.
ODIN_CORS_ORIGINS=https://odin.example.com

# --- LLM provider (pick one) -----------------------------------------------
ODIN_MODEL_PROVIDER=groq
ODIN_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Gemini alternative -----------------------------------------------------
# ODIN_MODEL_PROVIDER=gemini
# ODIN_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Daily briefing (optional) ---------------------------------------------
# ODIN_WEATHER_CITY=São José dos Campos
# ODIN_WEATHER_LAT=-23.1794
# ODIN_WEATHER_LON=-45.8869
# Comma-separated git repositories summarised in the briefing.
# ODIN_BRIEFING_REPOS=/opt/odin,/var/lib/odin/workspace

# --- Database ---------------------------------------------------------------
# Relative to the backend working directory. Point it at persistent storage.
DATABASE_URL=sqlite+aiosqlite:///./odin.db

# --- Debug ------------------------------------------------------------------
DEBUG=false
